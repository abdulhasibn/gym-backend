# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase (infrastructure/ only — never read outside src/infrastructure and src/config)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Required only for HS256 (local Docker). Hosted projects that sign
# with ES256 verify via JWKS (`getClaims`) and do not need this.
# SUPABASE_JWT_SECRET=your-jwt-secret-at-least-32-characters

# Used only by auth configure + db reset scripts (not read by the API process)
# Create a Web OAuth client in Google Cloud, then a personal access token at
# https://supabase.com/dashboard/account/tokens
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=igcmptpjmagzwoccxcnw
# SITE_URL=http://127.0.0.1:3000
#
# Daily wipe (auth users + public data, re-seed roles):
#   pnpm db:reset-data -- --yes
#   node --env-file=.env scripts/reset-dev-data.mjs --yes
#
# Custom SMTP unlocks OTP email templates on free tier (Resend example):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx
# SMTP_ADMIN_EMAIL=onboarding@resend.dev
# SMTP_SENDER_NAME=Gym Backend
